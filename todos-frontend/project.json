{
  "name": "todos-frontend",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "todos-frontend/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/todos-frontend",
        "configFile": "todos-frontend/vite.config.ts"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "serve": {
      "executor": "@nx/vite:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "todos-frontend:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "todos-frontend:build:development",
          "hmr": true
        },
        "production": {
          "buildTarget": "todos-frontend:build:production",
          "hmr": false
        }
      }
    },
    "preview": {
      "executor": "@nx/vite:preview-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "todos-frontend:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "todos-frontend:build:development"
        },
        "production": {
          "buildTarget": "todos-frontend:build:production"
        }
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "configFile": "todos-frontend/vite.config.ts",
        "passWithNoTests": true,
        "reportsDirectory": "../coverage/todos-frontend"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["todos-frontend/**/*.{ts,tsx,js,jsx}"]
      }
    }
  }
}
